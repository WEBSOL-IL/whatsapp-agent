# הגדרות השירות. הקובץ הפעיל הוא .env בתיקייה הקבועה של השירות
# (ברירת מחדל: whatsapp-agent-data בתיקיית הבית), והוא נוצר שם אוטומטית בהפעלה הראשונה.
# הנתיב המדויק כתוב בקובץ DATA-LOCATION.txt שבתיקיית הקוד. הקובץ .env לא נכנס ל-git.

# צימוד בקוד במקום QR: מספר הטלפון של החשבון, ספרות בלבד בפורמט בינלאומי, בלי +.
# השאר ריק כדי לצמד בסריקת QR.
PAIRING_PHONE=

# --- מנוע התמלול ---
# cloud = שירות ענן תואם Whisper. local = מודל מקומי (עדיין לא מומש).
TRANSCRIBER=cloud

# מפתח ה-API של שירות התמלול. חובה במצב cloud.
TRANSCRIBE_API_KEY=

# כתובת הבסיס של ה-API (תואם OpenAI). ברירת מחדל: https://api.openai.com/v1
# לספק אחר, למשל Groq: https://api.groq.com/openai/v1
TRANSCRIBE_API_BASE_URL=

# שם המודל אצל הספק. ברירת מחדל: whisper-1. יש לוודא את השם המדויק בתיעוד של הספק.
TRANSCRIBE_MODEL=

# רמז שפה, למשל he. ריק = זיהוי שפה אוטומטי.
# כדאי לקבוע he אם הודעות קצרות מזוהות בשפה שגויה.
TRANSCRIBE_LANGUAGE=

# verbose_json (ברירת מחדל, מחזיר גם שפה ואורך) או json למודלים שלא תומכים בו.
TRANSCRIBE_RESPONSE_FORMAT=

# --- שליחה ---
# מצב ניסוי. true (ברירת המחדל): שום דבר לא נשלח לוואטסאפ, ומה שהיה נשלח
# נכתב ל-data/dry-run.txt. כדי לשלוח באמת יש לקבוע false במפורש.
DRY_RUN=true

# --- גבולות ---
# אורך מרבי להודעה קולית בשניות (ברירת מחדל 600 = 10 דקות). ארוכה יותר מדולגת.
MAX_VOICE_SECONDS=

# הודעה ישנה מזה (בשניות) נחשבת היסטוריה ולא מתומללת (ברירת מחדל 60).
MAX_MESSAGE_AGE_SECONDS=

# כמה תמלולים רצים במקביל: 1 או 2 (ברירת מחדל 2).
QUEUE_CONCURRENCY=

# אזור הזמן להצגת שעת ההודעה (ברירת מחדל Asia/Jerusalem).
TIMEZONE=

# --- כללי ---
# תיקיית פרטי ההתחברות לוואטסאפ (ברירת מחדל: auth בתוך התיקייה הקבועה)
AUTH_DIR=

# תיקיית הנתונים וקבצי המצב (ברירת מחדל: data בתוך התיקייה הקבועה)
DATA_DIR=

# רמת לוג של האפליקציה: trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=info

# הלוג הפנימי של Baileys. כבוי כברירת מחדל כי הוא כולל מספרי טלפון.
# לפתוח רק לדיבוג נקודתי.
BAILEYS_LOG_LEVEL=silent
