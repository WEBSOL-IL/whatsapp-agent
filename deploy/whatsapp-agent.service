# שירות systemd להרצה קבועה על שרת לינוקס בלי Docker.
# לפני ההתקנה: החלף את YOUR_USER בשם המשתמש שמריץ, ואת /home/YOUR_USER/whatsapp-agent
# בנתיב המלא של התיקייה. אם node לא נמצא ב-/usr/bin/node, עדכן את הנתיב (בדוק עם: which node).
[Unit]
Description=WhatsApp voice message transcriber
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/whatsapp-agent
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=10
# שגיאת הגדרות (קוד 2) לא תיפתר בהפעלה מחדש
RestartPreventExitStatus=2
Environment=NODE_ENV=production
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
